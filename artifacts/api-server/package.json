{
  "name": "hyperagent-api-server",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP server for HyperAgent: A2A JSON-RPC endpoint, agent card, admin API and Whop webhooks. Starts background workers on boot.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "hyperagent-lib": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5"
  }
}
