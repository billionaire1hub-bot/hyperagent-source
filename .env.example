# ─── HyperAgent configuration ────────────────────────────────────────────────
# Copy to .env and fill in real values. Everything here is read by
# lib/src/config.ts; every value has a safe fallback, so the node never crashes
# when a variable is missing. `configWarnings()` (surfaced at boot and in
# GET /api/admin/status) lists the integrations that are running degraded.

# ── Identity & server ────────────────────────────────────────────────────────
# Stable id for this node. Set explicitly in production so peers recognise you.
AGENT_ID=
AGENT_NAME=HyperAgent
# Public URL peers use to reach this node (the A2A Agent Card advertises it).
# Leave empty to auto-detect from the platform: RENDER_EXTERNAL_URL,
# RAILWAY_PUBLIC_DOMAIN, FLY_APP_NAME or VERCEL_URL are used automatically.
AGENT_PUBLIC_URL=
PORT=12000
HOST=0.0.0.0
DATA_DIR=data
LOG_LEVEL=info

# ── Gemini (task valuation, bargaining, and real task execution) ─────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000
# Output budget + wall-clock budget for actually executing a task (not pricing).
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_EXECUTION_TIMEOUT_MS=60000

# ── Whop (balances, payments, payouts, webhooks) ─────────────────────────────
# Account API key from the Whop developer dashboard (Bearer token).
WHOP_API_KEY=
# Your Whop account id, prefixed `biz_`.
WHOP_COMPANY_ID=
WHOP_BASE_URL=https://api.whop.com/api/v1
# Optional: pin a dated API version (Api-Version-Date header), e.g. 2026-10-06-2
WHOP_API_VERSION_DATE=
# Signing secret from the Whop webhook settings; a `ws_...` string. Do not
# strip the prefix and do not base64-encode it. Required while
# WHOP_WEBHOOK_REQUIRE_SIGNATURE=true: without it every webhook is rejected 401.
WHOP_WEBHOOK_SECRET=
WHOP_WEBHOOK_REQUIRE_SIGNATURE=true
# Reject webhooks whose timestamp is older than this (replay protection).
WHOP_WEBHOOK_TOLERANCE_SEC=300
# Destination account for outbound payouts (user_/biz_/ldgr_). Defaults to the
# company id above.
WHOP_PAYOUT_DESTINATION_ID=
WHOP_TIMEOUT_MS=15000

# ── A2A network ──────────────────────────────────────────────────────────────
# A2A discovery/communication is ALWAYS on — there is no flag to disable it.
# Comma-separated registry endpoints that list active agents. If left empty the
# node self-registers against its own Agent Card to re-hydrate peers on restart.
# A public Agentverse-style registry (e.g. https://agentverse.ai/v1/search/agents)
# can be added here for real global peer discovery.
A2A_REGISTRY_URLS=
# Comma-separated peer base URLs to always probe. Defaults to localhost:12000/12001.
A2A_SEED_PEERS=
# Preferred protocol generation: v1 (SendMessage) or legacy (message/send).
A2A_PROTOCOL=v1
# Bearer token presented to peers that require auth.
A2A_AUTH_TOKEN=
# Bearer token required from inbound peers (leave empty for an open node).
A2A_INBOUND_AUTH_TOKEN=
A2A_DISCOVERY_INTERVAL_MS=60000
A2A_HANDSHAKE_TIMEOUT_MS=8000

# ── Pricing & bargaining ─────────────────────────────────────────────────────
MIN_TASK_PAYOUT=5
TASK_UNIT_RATE=10
TARGET_MARGIN_PCT=25
MAX_BARGAIN_ROUNDS=4
MIN_COUNTER_FRACTION=0.6
MAX_COUNTER_MULTIPLIER=3

# ── Workers ──────────────────────────────────────────────────────────────────
# Workers always start on boot (constant in code; this line is informational).
WORKER_ERROR_BACKOFF_MS=5000
WORKER_MAX_BACKOFF_MS=300000
# How often accepted tasks are executed and settled.
SETTLEMENT_INTERVAL_MS=15000

# ── Serverless cron tick (Vercel) ────────────────────────────────────────────
# On Vercel the in-process loops cannot run (functions are short-lived), so the
# same pipeline is driven by a scheduled GET to /api/cron/tick. Set CRON_SECRET
# to a random string; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# Without it the tick endpoint is disabled (returns 503) so it is never open.
CRON_SECRET=
# Pipeline cycles per tick (raise on low-frequency schedules, e.g. daily -> 8).
CRON_CYCLES=1
# Hard cap on CRON_CYCLES.
CRON_MAX_CYCLES=20
# Wall-clock budget per tick (ms). Real task execution is slow; the tick defers
# remaining tasks when this is spent, keeping it under the function maxDuration.
CRON_TICK_BUDGET_MS=240000
# Local/dev only: allow an unauthenticated tick when CRON_SECRET is unset.
CRON_ALLOW_UNAUTHENTICATED=false
